# Revenue AI environment variables. Copy to .env.local for development. Never commit real values.

# Public site URL (used in email, invitation and OAuth callback links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API). The anon key is safe for the browser; RLS applies.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Protects /api/cron (Vercel Cron sends it automatically). Use a long random value.
CRON_SECRET=
# Encrypts integration OAuth tokens at rest. Use a long random value and keep it stable.
INTEGRATION_ENCRYPTION_KEY=

# Selar payment notifications: shared secret for the webhook URL
SELAR_WEBHOOK_SECRET=

# AI (server only). Without a key the assistant answers common questions directly from your records.
ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-opus-5-5

# Optional transactional email (invitations fall back to a copyable link without it)
# RESEND_API_KEY=
# EMAIL_FROM="Revenue AI <noreply@yourdomain.com>"

# Optional integrations: each connector appears as configured only when both values are set
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# PIPEDRIVE_CLIENT_ID=
# PIPEDRIVE_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# SLACK_CLIENT_ID=
# SLACK_CLIENT_SECRET=
