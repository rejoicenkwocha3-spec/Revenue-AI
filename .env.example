# ---------------------------------------------------------------
# LinguaDub environment variables
# Copy to .env.local for development. Never commit real values.
# ---------------------------------------------------------------

# Public site URL (used in email links, consent and invitation links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this in client code.
SUPABASE_SERVICE_ROLE_KEY=

# Background worker: protects /api/jobs/process (Vercel Cron sends it automatically)
CRON_SECRET=

# --- AI providers (server only). Each feature turns on when its key is set. ---
# ElevenLabs: speech to text with speaker identification, voices, emotion and voice cloning
ELEVENLABS_API_KEY=
# OpenAI: Whisper transcription, translation and voices
OPENAI_API_KEY=
# DeepL: translation (keys ending in :fx use the free API)
DEEPL_API_KEY=

# Optional provider selection when several keys are set
# STT_PROVIDER=elevenlabs        # elevenlabs | openai
# TRANSLATION_PROVIDER=deepl     # deepl | openai
# TTS_PROVIDER=elevenlabs        # elevenlabs | openai
# VOICE_CLONING_PROVIDER=elevenlabs

# Optional model overrides
# ELEVENLABS_STT_MODEL=scribe_v1
# ELEVENLABS_TTS_MODEL=eleven_multilingual_v2
# OPENAI_TRANSLATION_MODEL=gpt-4.1-mini
# OPENAI_TTS_MODEL=gpt-4o-mini-tts

# --- Billing ---
# Shared secret for the Selar payment notification URL
SELAR_WEBHOOK_SECRET=
# Minutes allowed without a verified subscription (0 = processing requires a plan)
TRIAL_MINUTES=0

# --- Optional ---
# Transactional email for consent requests and invitations (Resend)
# RESEND_API_KEY=
# EMAIL_FROM="LinguaDub <noreply@yourdomain.com>"
# Upload limit in MB (keep in line with your Supabase Storage file size limit)
# NEXT_PUBLIC_MAX_UPLOAD_MB=2048
# Custom ffmpeg binary (defaults to the bundled ffmpeg-static)
# FFMPEG_PATH=
